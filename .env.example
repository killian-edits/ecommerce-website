# Supabase Public API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Server Role (Admin service key for webhook and backend operations)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Razorpay Integration Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_SECRET=yourRazorpaySecretHere
RAZORPAY_WEBHOOK_SECRET=yourWebhookSecretHere

# Application Host URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

